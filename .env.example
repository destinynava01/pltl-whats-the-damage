# Copy this file to .env.local and fill in the values.
# Use the SAME Supabase project as the PLTL game sites (Project Settings > API).
# Only the public "publishable" (anon) key goes here. Never put a service-role key in the website.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
